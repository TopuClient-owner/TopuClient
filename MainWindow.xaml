<Window x:Class="TopuLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Topu Client Launcher" Height="550" Width="900"
        WindowStyle="None" AllowsTransparency="True" Background="#121212"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom Window Titlebar -->
            <RowDefinition Height="40"/>
            <!-- Main Launcher Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border Grid.Row="0" Background="#1E1E1E" MouseDown="TitleBar_MouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="TOPU CLIENT" Foreground="#00FF88" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text=" | LAUNCHER" Foreground="#888888" FontSize="14" Margin="5,0,0,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="─" Click="Minimize_Click" Width="40" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" Foreground="#FF5555" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Client Info & Status -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="TOPU CLIENT" Foreground="White" FontSize="44" FontWeight="Black"/>
                <TextBlock Text="High-Performance Minecraft Client" Foreground="#00FF88" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>
                
                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#2A2A2A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="STATUS" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock x:Name="StatusText" Text="Ready to launch Topu Client." Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT PANEL: Authentication & Launch Controls -->
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="12" Padding="25" BorderBrush="#2A2A2A" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LOGIN METHOD" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                    
                    <ComboBox x:Name="AuthTypeBox" SelectionChanged="AuthTypeBox_SelectionChanged" 
                              Padding="8" Background="#2A2A2A" Foreground="White" Margin="0,0,0,15" Cursor="Hand">
                        <ComboBoxItem Content="Cracked / Offline" IsSelected="True"/>
                        <ComboBoxItem Content="Microsoft Premium"/>
                    </ComboBox>

                    <!-- CRACKED LOGIN PANEL -->
                    <StackPanel x:Name="CrackedPanel">
                        <TextBlock Text="OFFLINE USERNAME" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="UsernameInput" Text="TopuPlayer" Padding="8" 
                                 Background="#2A2A2A" Foreground="White" BorderThickness="1" BorderBrush="#333333" Margin="0,0,0,20"/>
                    </StackPanel>

                    <!-- MICROSOFT LOGIN PANEL -->
                    <StackPanel x:Name="PremiumPanel" Visibility="Collapsed">
                        <Button x:Name="MsLoginBtn" Content="Sign in with Microsoft" Click="MsLoginBtn_Click" 
                                Background="#0078D4" Foreground="White" Padding="10" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,20" Cursor="Hand"/>
                    </StackPanel>

                    <!-- LAUNCH BUTTON -->
                    <Button x:Name="LaunchBtn" Content="PLAY NOW" Click="LaunchBtn_Click" 
                            Background="#00FF88" Foreground="#000000" FontSize="18" FontWeight="Bold" 
                            Padding="12" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
