<Window x:Class="TopuLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Topu Client Launcher" Height="600" Width="980"
        WindowStyle="None" AllowsTransparency="True" Background="#121212"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="38"/>
            <!-- Navigation Bar -->
            <RowDefinition Height="48"/>
            <!-- Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border Grid.Row="0" Background="#181818" MouseDown="TitleBar_MouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="🛡️ TOPU CLIENT" Foreground="#00FF88" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text=" | v1.0.0" Foreground="#666666" FontSize="13" Margin="5,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="─" Click="Minimize_Click" Width="40" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" Foreground="#FF5555" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NAVIGATION TAB BAR -->
        <Border Grid.Row="1" Background="#161616" BorderBrush="#262626" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                <Button x:Name="TabLaunchBtn" Content="1. LAUNCH &amp; PARTNERED SERVERS" Click="SwitchTab_Click" Tag="TabLaunch"
                        Foreground="#00FF88" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="#00FF88"
                        FontWeight="Bold" FontSize="13" Padding="15,0" Cursor="Hand"/>
                <Button x:Name="TabProfilesBtn" Content="2. PROFILES" Click="SwitchTab_Click" Tag="TabProfiles"
                        Foreground="#888888" Background="Transparent" BorderThickness="0"
                        FontWeight="Bold" FontSize="13" Padding="15,0" Cursor="Hand"/>
                <Button x:Name="TabAccountsBtn" Content="3. ACCOUNTS" Click="SwitchTab_Click" Tag="TabAccounts"
                        Foreground="#888888" Background="Transparent" BorderThickness="0"
                        FontWeight="Bold" FontSize="13" Padding="15,0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="2" Margin="20">

            <!-- TAB 1: LAUNCH & PARTNERED SERVERS -->
            <Grid x:Name="TabLaunch" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.7*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Launch Engine -->
                <Border Grid.Column="0" Background="#181818" CornerRadius="10" Padding="20" BorderBrush="#262626" BorderThickness="1" Margin="0,0,15,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="LAUNCH ENGINE" Foreground="#888888" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        
                        <!-- Logo Emblem -->
                        <Border Width="110" Height="110" Background="#121212" CornerRadius="55" BorderBrush="#00FF88" BorderThickness="2" Margin="0,0,0,15">
                            <TextBlock Text="TU" Foreground="#00FF88" FontSize="42" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="TOPU CLIENT" Foreground="White" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SelectedProfileLabel" Text="Ready to launch Minecraft 1.21.1" Foreground="#888888" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                        <Button x:Name="LaunchBtn" Content="PLAY NOW" Click="LaunchBtn_Click"
                                Background="#00FF88" Foreground="Black" FontSize="18" FontWeight="Bold"
                                Height="50" Width="200" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <TextBlock x:Name="StatusText" Text="Status: Idle" Foreground="#666666" FontSize="11" HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Right Panel: Partnered Servers -->
                <Border Grid.Column="1" Background="#181818" CornerRadius="10" Padding="20" BorderBrush="#262626" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="PARTNERED SERVERS" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Server Card 1 -->
                                <Border Background="#202020" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#2A2A2A" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TOPU OFFICIAL NETWORK" Foreground="#00FF88" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="play.topuclient.net" Foreground="#888888" FontSize="12" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="📶 99 ms" Foreground="#00FF88" FontSize="11" Margin="0,0,15,0"/>
                                                <TextBlock Text="👤 5,432 Online" Foreground="#AAAAAA" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="JOIN" Click="JoinServer_Click" Tag="play.topuclient.net"
                                                Background="#00FF88" Foreground="Black" FontWeight="Bold" Width="70" Height="32" VerticalAlignment="Center" BorderThickness="0" Cursor="Hand"/>
                                    </Grid>
                                </Border>

                                <!-- Server Card 2 -->
                                <Border Background="#202020" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#2A2A2A" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PVP PRACTICE ARENA" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="practice.topuclient.net" Foreground="#888888" FontSize="12" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="📶 45 ms" Foreground="#00FF88" FontSize="11" Margin="0,0,15,0"/>
                                                <TextBlock Text="👤 1,200 Online" Foreground="#AAAAAA" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="JOIN" Click="JoinServer_Click" Tag="practice.topuclient.net"
                                                Background="#00FF88" Foreground="Black" FontWeight="Bold" Width="70" Height="32" VerticalAlignment="Center" BorderThickness="0" Cursor="Hand"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 2: PROFILES & MODS -->
            <Grid x:Name="TabProfiles" Visibility="Collapsed">
                <Border Background="#181818" CornerRadius="10" Padding="20" BorderBrush="#262626" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="PROFILE MANAGER" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Content="+ New Profile" HorizontalAlignment="Right" Background="#262626" Foreground="#00FF88" Padding="10,5" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                            </Grid>

                            <TextBlock Text="Minecraft Version" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="VersionBox" Padding="8" Background="#222222" Foreground="White" Margin="0,0,0,15">
                                <ComboBoxItem Content="1.21.1" IsSelected="True"/>
                                <ComboBoxItem Content="1.20.4"/>
                                <ComboBoxItem Content="1.19.2"/>
                            </ComboBox>

                            <TextBlock Text="RAM Allocation" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RamSlider" Minimum="2" Maximum="16" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RamSlider_ValueChanged"/>
                                <TextBlock x:Name="RamLabel" Grid.Column="1" Text="4GB" Foreground="#00FF88" FontWeight="Bold" Margin="10,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Mods List" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ModSodium" Content="sodium (FPS Engine)" IsChecked="True" Foreground="White" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ModIris" Content="iris (Shader Support)" IsChecked="True" Foreground="White" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ModMenu" Content="modmenu (Mod Config GUI)" IsChecked="True" Foreground="White" Margin="0,0,0,15"/>

                            <Button Content="Save Settings" Click="SaveProfile_Click" Background="#00FF88" Foreground="Black" FontWeight="Bold" Padding="10" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- TAB 3: ACCOUNTS -->
            <Grid x:Name="TabAccounts" Visibility="Collapsed">
                <Border Background="#181818" CornerRadius="10" Padding="20" BorderBrush="#262626" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="ACCOUNTS" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>

                        <StackPanel Grid.Row="1">
                            <!-- Microsoft Card -->
                            <Border Background="#202020" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="❖ " Foreground="#0078D4" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock x:Name="MsAccountName" Text="TopuDev" Foreground="White" FontWeight="Bold"/>
                                            <TextBlock Text="Microsoft Account" Foreground="#888888" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="✔ Active" Foreground="#00FF88" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Offline Card -->
                            <Border Background="#202020" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤 " Foreground="#888888" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBox x:Name="UsernameInput" Text="CrackedPlayer123" Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                                            <TextBlock Text="Offline" Foreground="#888888" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Inactive" Foreground="#666666" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Login Mode ComboBox -->
                            <TextBlock Text="Login Method" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,10,0,5"/>
                            <ComboBox x:Name="AuthTypeBox" SelectionChanged="AuthTypeBox_SelectionChanged" Background="#222222" Foreground="White" Padding="6">
                                <ComboBoxItem Content="Cracked / Offline" IsSelected="True"/>
                                <ComboBoxItem Content="Microsoft Account"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- x:Name="MsLoginBtn" assigned here -->
                        <Button x:Name="MsLoginBtn" Grid.Row="2" Content="Add Account" Click="MsLoginBtn_Click" Background="#00FF88" Foreground="Black" FontWeight="Bold" Height="40" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
